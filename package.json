{
  "name": "pumpseeker",
  "version": "1.0.0",
  "private": true,
  "description": "PumpSeeker — pump-momentum trading bot (paper) · modern remake of yosietserga's Crypto-Trends-Seeker engine",
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "postinstall": "prisma generate",
    "db:push": "prisma db push --accept-data-loss",
    "db:generate": "prisma generate",
    "engine:dev": "cd mini-services/pump-engine && bun run dev",
    "engine:start": "cd mini-services/pump-engine && bun run start"
  },
  "engines": {
    "node": ">=20"
  },
