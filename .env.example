# Copia este archivo a .env (o define las variables en tu plataforma)

# SQLite — relativo a prisma/schema.prisma (→ raíz/db/custom.db)
# Para persistencia en la nube: apunta a un volumen/disco, ej. file:/data/custom.db
DATABASE_URL=file:../db/custom.db

# REST del motor para el proxy /api/engine (dashboard → motor)
# Local: http://127.0.0.1:3004 · Nube: https://pumpseeker-engine.up.railway.app
ENGINE_URL=http://127.0.0.1:3004

# WebSocket del motor (navegador → motor, directo)
# Local/sandbox: dejar vacío · Nube: https://pumpseeker-engine.up.railway.app
NEXT_PUBLIC_ENGINE_WS_URL=
NEXT_PUBLIC_ENGINE_WS_PATH=/engine

# —— modo demo (UN CLIC: el dropdown del login llena email+contraseña) ——
# ⚠️ DESACTIVAR EN PRODUCCIÓN: guarda/serve contraseñas en claro para la demo
DEMO_MODE=false

# —— autenticación multi-usuario (web) ——
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=cambia-esto-por-un-secreto-largo

# —— variables del MOTOR (mini-services/pump-engine) ——

# A dónde persiste señales/trades/snapshots (la URL pública del web)
INGEST_URL=http://localhost:3000/api/ingest

# Modo de puertos del motor:
# - Sin SOCKET_PATH (local): socket.io :3003 (path "/") + REST :3004
# - SOCKET_PATH=/engine (nube): un solo puerto ($PORT) con socket.io + REST
SOCKET_PATH=/engine
# SOCKET_PORT=3003
# REST_PORT=3004
