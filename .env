# PumpSeeker — valores por defecto seguros (sin secretos).
# Esto permite builds zero-config en Railway/Render/Vercel.
# Para persistencia real, sobreescribe DATABASE_URL con un volumen/disco montado.

# SQLite (relativo a prisma/schema.prisma → raíz del repo)
DATABASE_URL=file:../db/custom.db

# URL del REST del motor (para el proxy /api/engine del dashboard)
# Local: http://127.0.0.1:3004 · Nube: https://<tu-servicio-del-motor>
ENGINE_URL=http://127.0.0.1:3004

# sesión multi-usuario (reemplaza el secret en producción)
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=genera-un-secreto-largo-y-aleatorio

# URL pública del socket.io del motor (la usa el navegador)
# Vacío = modo local/sandbox. Nube: https://<tu-servicio-del-motor>
NEXT_PUBLIC_ENGINE_WS_URL=
NEXT_PUBLIC_ENGINE_WS_PATH=/engine
